# Padroniza texto no repositorio e evita avisos LF/CRLF entre Windows e CI.
* text=auto

*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.jks  binary
*.apk  binary
*.zip  binary
